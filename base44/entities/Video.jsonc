{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do v\u00eddeo"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do v\u00eddeo"
    },
    "video_url": {
      "type": "string",
      "description": "URL do v\u00eddeo (YouTube embed ou arquivo)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL da imagem de capa"
    },
    "category": {
      "type": "string",
      "enum": [
        "desenhos",
        "musicas",
        "educativos",
        "historias",
        "jogos"
      ],
      "description": "Categoria do v\u00eddeo"
    },
    "age_group": {
      "type": "string",
      "enum": [
        "0-3",
        "4-6",
        "7-9",
        "10-12"
      ],
      "description": "Faixa et\u00e1ria recomendada"
    },
    "duration": {
      "type": "string",
      "description": "Dura\u00e7\u00e3o do v\u00eddeo"
    },
    "views": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de visualiza\u00e7\u00f5es"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 um v\u00eddeo em destaque"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "channel_id": {
      "type": "string",
      "description": "ID do canal do criador de conte\u00fado"
    }
  },
  "required": [
    "title",
    "video_url",
    "category",
    "age_group"
  ]
}